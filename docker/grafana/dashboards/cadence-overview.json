    {
      "id": 17,
      "type": "timeseries",
      "title": "Connection pool in use",
      "description": "\"waiting\" above 0 means requests are queuing for a database connection.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 31
      },
      "targets": [
