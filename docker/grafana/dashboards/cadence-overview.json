      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$application\", application!~\"discovery-service|config-server\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{application}}",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
