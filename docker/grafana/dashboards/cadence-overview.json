      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$application\", application!~\"discovery-service|config-server\", uri!~\"/actuator.*\", status=~\"5..\"}[$__rate_interval])) or sum by (application) (rate(http_server_requests_seconds_count{application=~\"$application\", application!~\"discovery-service|config-server\", uri!~\"/actuator.*\"}[$__rate_interval])) * 0",
          "legendFormat": "{{application}}",
